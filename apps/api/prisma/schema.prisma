datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

enum Role {
  INSTITUTE_ADMIN
  RESEARCH_SUPERVISOR
  RESEARCH_SCHOLAR
}

enum UserStatus {
  ACTIVE
  PENDING_SUPERVISOR_APPROVAL
  REJECTED
  SUSPENDED
  DEACTIVATED
  RESTRICTED
}

model User {
  id            String          @id @default(cuid())
  supabaseAuthId String?        @unique
  clerkId       String?         @unique
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  role          Role            @default(RESEARCH_SCHOLAR)
  department    String?
  departmentId  String?
  departmentRef Department?     @relation(fields: [departmentId], references: [id])
  faculty       String?
  bio           String?
  approved      Boolean         @default(false)
  status        UserStatus      @default(ACTIVE)
  approvedBy    String?
  approvedAt    DateTime?
  suspended     Boolean         @default(false)
  supervisorId  String?
  supervisorEmail String?
  employeeId    String?         @unique
  onboardingCompleted Boolean   @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  interests     UserInterest[]
  threads       Thread[]
  comments      Comment[]
  opportunities Opportunity[]
  notificationTokens NotificationToken[]
  notifications Notification[]
  preferences   UserPreference?
  
  // New profile relations
  supervisorProfile SupervisorProfile?
  scholarProfile   ScholarProfile?
  scholarRequests  ScholarSupervisorRequest[] @relation("ScholarSupervisorRequests")
  supervisorRequests ScholarSupervisorRequest[] @relation("SupervisorScholarRequests")

  // Supervisor/Scholar mappings (kept for legacy query compatibility)
  supervisor    User?           @relation("SupervisorScholars", fields: [supervisorId], references: [id])
  scholars      User[]          @relation("SupervisorScholars")
  
  // Collaboration and Workspace relations
  collaborationRequests CollaborationRequest[]
  workspaceMembers      WorkspaceMember[]
  workspaceAnnouncements WorkspaceAnnouncement[]
  workspaceFiles        WorkspaceFile[]
  publications          Publication[]
  submittedReports      Report[]                @relation("ScholarReports")
  reviewedReports       Report[]                @relation("SupervisorReports")
  systemAnnouncements   SystemAnnouncement[]

  // Feed/Post relations
  threadLikes          ThreadLike[]
  commentLikes         CommentLike[]
  threadShares         ThreadShare[]
  threadReports        ThreadReport[]
  savedThreads         SavedThread[]
  connectionsRequested ResearchConnection[] @relation("ConnectionRequester")
  connectionsReceived  ResearchConnection[] @relation("ConnectionReceiver")
  hostedEvents         Event[]
  // Researcher Network Follow Relations
  following            UserFollow[]   @relation("UserFollowing")
  followers            UserFollow[]   @relation("UserFollowers")
  followedDomains      DomainFollow[]
  followedTopics       TopicFollow[]

  // Research Collaboration relations
  collabRequestsSent      ResearchCollabRequest[]   @relation("CollabRequestSender")
  collabRequestsReceived  ResearchCollabRequest[]   @relation("CollabRequestReceiver")
  collaborationsRequested ResearchCollaboration[]   @relation("CollabRequester")
  collaborationsReceived  ResearchCollaboration[]   @relation("CollabRecipient")
  collaborationMessages   CollaborationMessage[]    @relation("CollabMessageSender")

  // Research Profile & Activity relations
  researchProfile         ResearchProfile?
  researchActivities      ResearchActivity[]
  externalLinks           ResearcherExternalLink[]

  // Integrations & Meetings relations
  integrationConnections  IntegrationConnection[]
  meetingsCreated         ResearchMeeting[]         @relation("MeetingCreator")
  filedReports            ModerationReport[]        @relation("ReportedBy")

  @@index([departmentId])
  @@index([supervisorId])
}

model UserFollow {
  id                 String   @id @default(cuid())
  followerId         String
  followingId        String
  notificationsEnabled Boolean @default(true)
  createdAt          DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model DomainFollow {
  id        String   @id @default(cuid())
  userId    String
  domain    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId])
  @@index([domain])
}

model TopicFollow {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId])
  @@index([topic])
}

// CuriousBees Custom Platform Models
model ResearchInterest {
  id    String         @id @default(cuid())
  name  String         @unique
  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   ResearchInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

enum ThreadType {
  TEXT
  RESEARCH_UPDATE
  DISCUSSION
  QUESTION
  ANNOUNCEMENT
  PUBLICATION
  ACHIEVEMENT
  COLLABORATION_REQUEST
}

model Thread {
  id        String    @id @default(cuid())
  title     String
  content   String    @db.Text
  type      ThreadType @default(TEXT)
  isPaper   Boolean   @default(false)
  paperJournal String?
  hidden    Boolean   @default(false)
  moderatedAt DateTime?
  moderatedBy String?
  moderationReason String?
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags      String[]
  comments  Comment[]
  attachments ThreadAttachment[]
  likes       ThreadLike[]
  shares      ThreadShare[]
  reports     ThreadReport[]
  saves       SavedThread[]
  collaborationRequests CollaborationRequest[]
  collabRequests          ResearchCollabRequest[]   @relation("CollabRequestThread")
  researchCollaborations  ResearchCollaboration[]   @relation("CollabThread")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([authorId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([threadId])
  @@index([authorId])
  @@index([parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model Opportunity {
  id                String    @id @default(cuid())
  title             String
  description       String    @db.Text
  department        String
  researchDomain    String
  opportunityType   String    @default("PhD Position")
  positionsCount    Int       @default(1)
  funding           String    @default("Fully Funded")
  fundingDetails    String?
  eligibility       String[]  @default([])
  deadline          DateTime?
  mode              String    @default("On Campus")
  applicationMethod String    @default("CuriousBees")
  applicationUrl    String?
  applicationEmail  String?
  authorId          String
  author            User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  collaborationRequests CollaborationRequest[]

  @@index([authorId])
}

enum ApprovalStatus {
  PENDING
  PUBLISHED
  REJECTED
  NEEDS_INFO
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SystemAnnouncement {
  id          String             @id @default(cuid())
  title       String
  content     String             @db.Text
  status      AnnouncementStatus @default(DRAFT)
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  pushToEmail Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([authorId])
}



enum EventStatus {
  DRAFT
  PUBLISHED
  REVIEW_REQUIRED
  FAILED
}

enum EventPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Event {
  id                String         @id @default(cuid())
  title             String
  eventType         String
  speaker           String?
  department        String?
  date              DateTime
  time              String
  venue             String
  topic             String?
  organizerEmail    String?
  status            EventStatus
  priority          EventPriority  @default(MEDIUM)

  // Kept from previous iterations
  description       String?        @db.Text
  category          String?
  posterUrl         String?
  registrationLink  String?
  tags              String[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  authorId          String?
  author            User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  notifications     Notification[]

}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  eventId       String?
  title         String
  body          String
  sentStatus    Boolean  @default(false)
  openedStatus  Boolean  @default(false)
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  type          String?
  actionUrl     String?

  createdAt     DateTime @default(now())
  readAt        DateTime?

  @@index([userId])
  @@index([eventId])
}

model NotificationLog {
  id            String   @id @default(cuid())
  eventId       String
  recipientType String
  channel       String
  status        String
  sentAt        DateTime @default(now())
}

model UserPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  department           String?
  eventType            String?
  tags                 String[]
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}



model CollaborationRequest {
  id             String         @id @default(cuid())
  scholarId      String
  opportunityId  String?
  threadId       String?
  status         ApprovalStatus @default(PENDING)
  message        String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  scholar        User           @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  opportunity    Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  thread         Thread?        @relation(fields: [threadId], references: [id], onDelete: Cascade)

  // @@unique([scholarId, opportunityId])
  @@index([scholarId])
  @@index([opportunityId])
  @@index([threadId])
}

model Workspace {
  id                    String                  @id @default(cuid())
  title                 String
  description           String?                 @db.Text
  collaborationProvider IntegrationProvider     @default(GOOGLE_WORKSPACE)
  googleChatSpaceId     String?
  googleChatSpaceUrl    String?
  zoomMeetingId         String?
  zoomJoinUrl           String?
  externalMeetingUrl    String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  members               WorkspaceMember[]
  files                 WorkspaceFile[]
  milestones            WorkspaceMilestone[]
  announcements         WorkspaceAnnouncement[]
  researchCollaboration ResearchCollaboration?
  meetings              ResearchMeeting[]
}

model WorkspaceMember {
  workspaceId   String
  userId        String
  role          String                  @default("MEMBER") // "OWNER" | "MEMBER"
  joinedAt      DateTime                @default(now())

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model WorkspaceFile {
  id            String                  @id @default(cuid())
  workspaceId   String
  name          String
  url           String
  size          Int                     @default(0)
  uploadedById  String
  uploadedAt    DateTime                @default(now())

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy    User                    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([uploadedById])
}

model WorkspaceMilestone {
  id            String                  @id @default(cuid())
  workspaceId   String
  title         String
  description   String?                 @db.Text
  dueDate       DateTime?
  completed     Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceAnnouncement {
  id            String                  @id @default(cuid())
  workspaceId   String
  title         String
  content       String                  @db.Text
  authorId      String
  createdAt     DateTime                @default(now())

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author        User                    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([authorId])
}

model AuditLog {
  id            String    @id @default(cuid())
  userId        String?   // legacy backward compat
  actorId       String?
  actorEmail    String?
  actorName     String?
  actorRole     String?
  action        String    // e.g. "USER_SUSPENDED", "USER_REACTIVATED", "ROLE_CHANGED", "SUPERVISOR_REASSIGNED", "POST_HIDDEN", etc.
  targetId      String?
  targetType    String?   // e.g. "USER", "POST", "PUBLICATION", "REPORT", "FACULTY", "DEPARTMENT", "SYSTEM_SETTING"
  category      String?   @default("GOVERNANCE") // e.g. "USER", "ACCESS", "ROLE", "MODERATION", "RESEARCH_GOVERNANCE", "SECURITY", "SYSTEM", "INSTITUTION", "NOTIFICATION"
  severity      String?   @default("LOW") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  details       String?   @db.Text
  previousState Json?
  newState      Json?
  metadata      Json?
  status        String    @default("SUCCESS") // "SUCCESS", "FAILED"
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([action])
  @@index([actorId])
  @@index([category])
  @@index([createdAt])
}

model NotificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faculty {
  id                String              @id @default(cuid())
  name              String              @unique
  departments       Department[]
  supervisorProfiles SupervisorProfile[]
  scholarProfiles   ScholarProfile[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Department {
  id                String              @id @default(cuid())
  facultyId         String
  faculty           Faculty             @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  name              String
  code              String              @unique
  description       String?             @db.Text
  users             User[]              // backward compatibility
  supervisorProfiles SupervisorProfile[]
  scholarProfiles   ScholarProfile[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([facultyId])
}

model SupervisorProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyId     String
  faculty       Faculty     @relation(fields: [facultyId], references: [id])
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  designation   String
  employeeId    String      @unique
  researchArea  String?
  maxScholars   Int         @default(6)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([facultyId])
  @@index([departmentId])
}

model ScholarProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyId     String
  faculty       Faculty     @relation(fields: [facultyId], references: [id])
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])
  researchArea  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([facultyId])
  @@index([departmentId])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ScholarSupervisorRequest {
  id            String        @id @default(cuid())
  scholarId     String
  scholar       User          @relation("ScholarSupervisorRequests", fields: [scholarId], references: [id], onDelete: Cascade)
  supervisorId  String
  supervisor    User          @relation("SupervisorScholarRequests", fields: [supervisorId], references: [id], onDelete: Cascade)
  status        RequestStatus @default(PENDING)
  message       String?
  rejectionReason String?
  respondedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([scholarId])
  @@index([supervisorId])
  @@index([scholarId, supervisorId, status])
}


model Publication {
  id          String   @id @default(cuid())
  title       String
  authors     String   // Comma-separated list of author names
  doi         String?
  publisher   String?
  year        Int
  status      String   // e.g. "DRAFT" | "SUBMITTED" | "PUBLISHED" | "UNDER_REVIEW"
  hidden      Boolean  @default(false)
  moderatedAt DateTime?
  moderatedBy String?
  moderationReason String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Report {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  status        String   // e.g. "PENDING" | "APPROVED" | "REJECTED" | "NEEDS_INFO"
  evidenceUrl   String?
  feedback      String?  @db.Text
  scholarId     String
  scholar       User     @relation("ScholarReports", fields: [scholarId], references: [id], onDelete: Cascade)
  supervisorId  String
  supervisor    User     @relation("SupervisorReports", fields: [supervisorId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([scholarId])
  @@index([supervisorId])
}

// ============================================
// Research Feed Models
// ============================================

enum AttachmentType {
  PDF
  IMAGE
  VIDEO
  DOCUMENT
}

model ThreadAttachment {
  id        String         @id @default(cuid())
  threadId  String
  name      String
  url       String
  size      Int            @default(0)
  type      AttachmentType @default(DOCUMENT)
  createdAt DateTime       @default(now())

  thread    Thread         @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model ThreadLike {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([threadId])
  @@index([userId])
}

model ThreadShare {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  platform  String?
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([userId])
}

model ThreadReport {
  id          String   @id @default(cuid())
  threadId    String
  reporterId  String
  reason      String
  description String?
  status      String   @default("PENDING")
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  reporter  User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([reporterId])
}

model SavedThread {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([threadId])
  @@index([userId])
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  REJECTED
}

model ResearchConnection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
}

enum CollabRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum CollaborationStatus {
  ACTIVE
  CLOSED
}

model ResearchCollabRequest {
  id            String              @id @default(cuid())
  requesterId   String
  recipientId   String
  threadId      String?
  message       String?             @db.Text
  status        CollabRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  requester     User                @relation("CollabRequestSender", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient     User                @relation("CollabRequestReceiver", fields: [recipientId], references: [id], onDelete: Cascade)
  thread        Thread?             @relation("CollabRequestThread", fields: [threadId], references: [id], onDelete: SetNull)

  @@index([requesterId])
  @@index([recipientId])
  @@index([threadId])
}

model ResearchCollaboration {
  id              String              @id @default(cuid())
  requesterId     String
  recipientId     String
  threadId        String?
  workspaceId     String?             @unique
  status          CollaborationStatus @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lastActivityAt  DateTime            @default(now())

  requester       User                @relation("CollabRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient       User                @relation("CollabRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  thread          Thread?             @relation("CollabThread", fields: [threadId], references: [id], onDelete: SetNull)
  workspace       Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages        CollaborationMessage[]

  @@index([requesterId])
  @@index([recipientId])
  @@index([workspaceId])
}

model CollaborationMessage {
  id              String                @id @default(cuid())
  collaborationId String
  senderId        String
  content         String                @db.Text
  createdAt       DateTime              @default(now())

  collaboration   ResearchCollaboration  @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  sender          User                   @relation("CollabMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([collaborationId])
  @@index([senderId])
}

// ============================================
// My Research Module Models
// ============================================

enum ResearchStatus {
  ACTIVE
  NOT_STARTED
  ON_HOLD
  COMPLETED
}

enum ResearchStage {
  PROPOSAL
  LITERATURE_REVIEW
  METHODOLOGY
  IMPLEMENTATION
  EVALUATION
  THESIS_PUBLICATION
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum MilestonePriority {
  LOW
  MEDIUM
  HIGH
}

model ResearchProfile {
  id                    String            @id @default(cuid())
  scholarId             String            @unique
  scholar               User              @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  title                 String
  researchArea          String
  abstract              String?           @db.Text
  status                ResearchStatus    @default(ACTIVE)
  currentStage          ResearchStage     @default(PROPOSAL)
  startDate             DateTime?
  expectedCompletionDate DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  milestones            ResearchMilestone[]
  activities            ResearchActivity[]

  @@index([scholarId])
}

model ResearchMilestone {
  id                String            @id @default(cuid())
  researchProfileId String
  researchProfile   ResearchProfile   @relation(fields: [researchProfileId], references: [id], onDelete: Cascade)
  title             String
  description       String?           @db.Text
  stage             ResearchStage     @default(PROPOSAL)
  status            MilestoneStatus   @default(UPCOMING)
  priority          MilestonePriority @default(MEDIUM)
  dueDate           DateTime?
  completedAt       DateTime?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([researchProfileId])
}

model ResearchActivity {
  id                String          @id @default(cuid())
  researchProfileId String
  researchProfile   ResearchProfile @relation(fields: [researchProfileId], references: [id], onDelete: Cascade)
  actorId           String
  actor             User            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  type              String
  description       String
  metadata          String?         @db.Text
  createdAt         DateTime        @default(now())

  @@index([researchProfileId])
  @@index([actorId])
}

model ResearcherExternalLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String   // e.g. "ORCID", "GOOGLE_SCHOLAR", "RESEARCHGATE", "GITHUB", "LINKEDIN", "WEBSITE", "PORTFOLIO", "YOUTUBE", "TWITTER", "OTHER"
  label     String?
  url       String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform])
  @@index([userId])
}

// ============================================
// Google Workspace & Zoom Integration Models
// ============================================

enum IntegrationProvider {
  GOOGLE_WORKSPACE
  ZOOM_WORKPLACE
  EXTERNAL
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  EXPIRED
  REAUTH_REQUIRED
  DISCONNECTED
  ERROR
}

enum MeetingProvider {
  GOOGLE_MEET
  ZOOM
  EXTERNAL
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model IntegrationConnection {
  id                   String              @id @default(cuid())
  userId               String
  provider             IntegrationProvider
  status               IntegrationStatus   @default(NOT_CONNECTED)
  externalAccountId    String?
  externalAccountEmail String?
  accessToken          String?             @db.Text
  refreshToken         String?             @db.Text
  tokenExpiresAt       DateTime?
  scopes               String?             @db.Text
  lastError            String?             @db.Text
  connectedAt          DateTime?
  updatedAt            DateTime            @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model ResearchMeeting {
  id                String          @id @default(cuid())
  workspaceId       String
  createdById       String
  provider          MeetingProvider @default(GOOGLE_MEET)
  externalMeetingId String?
  meetingUrl        String
  title             String
  description       String?         @db.Text
  scheduledAt       DateTime
  duration          Int             @default(30)
  status            MeetingStatus   @default(SCHEDULED)
  recordingUrl      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User            @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdById])
  @@index([scheduledAt])
}

model InstitutionIntegrationSetting {
  id                     String   @id @default(cuid())
  googleWorkspaceEnabled Boolean  @default(true)
  zoomWorkplaceEnabled   Boolean  @default(true)
  externalLinksEnabled   Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

model ModerationReport {
  id            String    @id @default(cuid())
  reporterId    String?
  reporter      User?     @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType    String    // "POST", "PUBLICATION", "USER", "COMMENT"
  targetId      String
  reason        String
  description   String?   @db.Text
  severity      String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status        String    @default("OPEN")   // "OPEN", "UNDER_REVIEW", "RESOLVED", "DISMISSED"
  resolvedById  String?
  resolutionNote String?  @db.Text
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

model Campus {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  location    String?
  status      String   @default("ACTIVE") // "ACTIVE", "ARCHIVED"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String   @default("GENERAL") // "GENERAL", "INSTITUTION", "AUTHENTICATION", "EMAIL", "NOTIFICATIONS", "SECURITY", "INTEGRATIONS", "MODERATION"
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

