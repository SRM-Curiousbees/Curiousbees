    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^8.0.1",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.112.3",
    "class-transformer": "^0.5.1",
