{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@curiousbees/constants": [
        "../../packages/constants/src"
      ],
      "@curiousbees/types": [
        "../../packages/types"
      ],
      "@curiousbees/shared-utils": [
        "../../packages/shared-utils"
      ],
      "@curiousbees/ui": [
        "../../packages/ui/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "node_modules/.cache/next-darkbuild/types/**/*.ts",
    "node_modules/.cache/next-uiharness/types/**/*.ts",
    "node_modules/.cache/next-prodcheck/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
