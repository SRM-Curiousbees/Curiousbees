# ==========================================
# CURIOUSBEES V2 — PRODUCTION WEB DOCKERFILE
# ==========================================
# Next.js standalone server (SSR + middleware), so it needs a Node runtime.
#
# PUBLIC build args (inlined into the browser bundle — never pass secrets):
#   NEXT_PUBLIC_SITE_URL           canonical origin, e.g. https://srmcuriousbees.in
#   NEXT_PUBLIC_API_URL            API origin, e.g. https://srmcuriousbees.in (API served under /api)
#   NEXT_PUBLIC_SUPABASE_URL       Supabase project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  Supabase anon (publishable) key — public by design
#   NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS  optional UX hint; the API enforces the real policy
#
# SERVER-ONLY runtime env (task definition, not build args):
#   APP_URL, ALLOWED_EMAIL_DOMAINS
#
#   docker build -f Dockerfile.web \
#     --build-arg NEXT_PUBLIC_SITE_URL=... --build-arg NEXT_PUBLIC_API_URL=... \
#     --build-arg NEXT_PUBLIC_SUPABASE_URL=... --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY=... \
#     -t curiousbees-web .

# --- 1. Base ---
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat
ENV NEXT_TELEMETRY_DISABLED=1

# --- 2. Dependencies (dev dependencies are needed to build) ---
FROM base AS dependencies
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY packages/types/package.json ./packages/types/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/constants/package.json ./packages/constants/
COPY packages/ui/package.json ./packages/ui/
# Skip the API's Prisma engine downloads; the web app does not use Prisma.
ENV PRISMA_SKIP_POSTINSTALL_GENERATE=1
RUN npm ci --legacy-peer-deps --no-audit --no-fund \
 && mkdir -p apps/web/node_modules

# --- 3. Build ---
FROM base AS builder
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=dependencies /app/apps/web/node_modules ./apps/web/node_modules
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/web ./apps/web

ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=""
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=$NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS

# next.config.ts validates the NEXT_PUBLIC_* values and fails the build if any is missing.
RUN npm run build:web

# --- 4. Runtime ---
FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache libc6-compat \
 && addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs nextjs
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/healthz >/dev/null || exit 1

CMD ["node", "apps/web/server.js"]
