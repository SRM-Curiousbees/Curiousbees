# ==========================================
# CURIOUSBEES V2 — PRODUCTION API DOCKERFILE
# ==========================================
# Build from the repository root:
#   docker build -f Dockerfile.api -t curiousbees-api .
#
# One image serves three roles (the ECS task definition picks the command):
#   API server  : node apps/api/dist/main.js                       (default)
#   Migrations  : npx prisma migrate deploy --schema apps/api/prisma/schema.prisma
#   Seed        : node apps/api/dist/scripts/seed-production.js

# --- 1. Base ---
FROM node:22-alpine AS base
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl
ENV NEXT_TELEMETRY_DISABLED=1 \
    CHECKPOINT_DISABLE=1

# --- 2. Full dependency install (dev dependencies are needed to compile) ---
# NODE_ENV is intentionally not "production" here: npm would skip devDependencies.
FROM base AS dependencies
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/types/package.json ./packages/types/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/constants/package.json ./packages/constants/
COPY packages/ui/package.json ./packages/ui/
RUN npm ci --legacy-peer-deps --no-audit --no-fund

# --- 3. Build shared packages + API ---
FROM base AS builder
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/api ./apps/api
# Builds packages/{types,constants,shared-utils}, runs `prisma generate`, then `nest build` -> apps/api/dist
RUN npm run build:api

# --- 4. Production-only dependencies for the API workspace ---
FROM base AS prod-deps
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/types/package.json ./packages/types/
COPY packages/shared-utils/package.json ./packages/shared-utils/
COPY packages/constants/package.json ./packages/constants/
COPY packages/ui/package.json ./packages/ui/
COPY apps/api/prisma ./apps/api/prisma
RUN npm ci --omit=dev --workspace=apps/api --legacy-peer-deps --no-audit --no-fund \
 && npx prisma generate --schema apps/api/prisma/schema.prisma \
 && mkdir -p apps/api/node_modules

# --- 5. Runtime ---
FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl \
 && addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 --ingroup nodejs nestjs
ENV NODE_ENV=production \
    PORT=4000 \
    CHECKPOINT_DISABLE=1

COPY --from=prod-deps --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=prod-deps --chown=nestjs:nodejs /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=nestjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/dist ./apps/api/dist
# Workspace packages are symlinked from node_modules/@curiousbees/* -> packages/*
COPY --from=builder --chown=nestjs:nodejs /app/packages/types/package.json ./packages/types/package.json
COPY --from=builder --chown=nestjs:nodejs /app/packages/types/dist ./packages/types/dist
COPY --from=builder --chown=nestjs:nodejs /app/packages/constants/package.json ./packages/constants/package.json
COPY --from=builder --chown=nestjs:nodejs /app/packages/constants/dist ./packages/constants/dist
COPY --from=builder --chown=nestjs:nodejs /app/packages/shared-utils/package.json ./packages/shared-utils/package.json
COPY --from=builder --chown=nestjs:nodejs /app/packages/shared-utils/dist ./packages/shared-utils/dist

USER nestjs
EXPOSE 4000

# Container-level liveness (ECS can use the same path). Does not touch the database.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4000/api/health/live >/dev/null || exit 1

CMD ["node", "apps/api/dist/main.js"]
