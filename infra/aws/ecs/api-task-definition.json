{
  "family": "curiousbees-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/curiousbees-ecs-execution",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/curiousbees-api-task",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "${API_IMAGE}",
      "essential": true,
      "portMappings": [{ "containerPort": 4000, "protocol": "tcp", "name": "api" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "4000" },
        { "name": "FRONTEND_URL", "value": "${APP_URL}" },
        { "name": "ALLOWED_EMAIL_DOMAINS", "value": "${ALLOWED_EMAIL_DOMAINS}" },
        { "name": "SUPABASE_URL", "value": "${SUPABASE_URL}" },
        { "name": "AWS_REGION", "value": "${AWS_REGION}" },
        { "name": "AWS_S3_BUCKET", "value": "${S3_BUCKET}" },
        { "name": "TRUST_PROXY_HOPS", "value": "2" },
        { "name": "MAIL_FROM_EMAIL", "value": "${MAIL_FROM_EMAIL}" },
        { "name": "MAIL_FROM_NAME", "value": "CuriousBees SRMIST" },
        { "name": "ENABLE_CRON", "value": "true" },
        { "name": "ENABLE_SWAGGER", "value": "false" },
        { "name": "CHECKPOINT_DISABLE", "value": "1" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter/curiousbees/prod/DATABASE_URL" },
        { "name": "DIRECT_URL", "valueFrom": "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter/curiousbees/prod/DIRECT_URL" },
        { "name": "SUPABASE_SERVICE_ROLE_KEY", "valueFrom": "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter/curiousbees/prod/SUPABASE_SERVICE_ROLE_KEY" },
        { "name": "BREVO_API_KEY", "valueFrom": "arn:aws:ssm:${AWS_REGION}:${AWS_ACCOUNT_ID}:parameter/curiousbees/prod/BREVO_API_KEY" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:4000/api/health/live >/dev/null || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "stopTimeout": 30,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/curiousbees-api",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "api"
        }
      }
    }
  ]
}
