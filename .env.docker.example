# Credentials for the local Docker Postgres (docker-compose.yml / docker-compose.dev.yml).
# Copy to .env.docker (git-ignored) and fill in a generated password, e.g. `openssl rand -hex 24`.
# Use the same password in all three lines. Compose refuses to start without this file.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/srm_curiousbees_db?schema=public
DIRECT_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/srm_curiousbees_db?schema=public
