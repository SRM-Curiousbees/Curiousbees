# ==============================================================================
# CURIOUSBEES V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your deployment-specific credentials.
# Do NOT commit real secrets to version control.
# ==============================================================================

# Application
NODE_ENV=
PORT=
FRONTEND_URL=
ALLOWED_ORIGINS=
ALLOWED_EMAIL_DOMAINS=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
# Optional. Public contact address shown on /contact; the page shows no address when unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# Database (AWS Managed PostgreSQL / RDS / Aurora)
DATABASE_URL=

# AWS S3 (Object Storage)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Supabase Auth (Authentication & Session Tokens ONLY)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoom Workplace Integration
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Brevo (Transactional Email Delivery)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# AWS OpenSearch
OPENSEARCH_ENDPOINT=
OPENSEARCH_REGION=
OPENSEARCH_INDEX=

# Optional Administration & Operations
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
MAIN_ADMIN_EMAIL=
TRUST_PROXY_HOPS=
ENABLE_CRON=
ENABLE_SWAGGER=
