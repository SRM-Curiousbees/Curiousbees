# ==============================================================================
# CURIOUSBEES V2 — ENVIRONMENT TEMPLATE
# ==============================================================================
# Local development: copy to .env at the repo root and fill in.
# Production (AWS ECS): NOTHING here is read from a file. Plain values come from
# the ECS task definition; secrets come from SSM Parameter Store (SecureString)
# injected as container secrets. See docs/deployment/aws-production.md.
#
# Never commit real values. Never put AWS access keys here: locally use your AWS
# CLI profile (AWS_PROFILE), in ECS the task role provides credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# A. PUBLIC — web build args (inlined into the browser bundle at `next build`)
#    Anything NEXT_PUBLIC_* is visible to every visitor. No secrets here.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"          # prod: https://srmcuriousbees.in
NEXT_PUBLIC_API_URL="http://localhost:4000"           # prod: https://srmcuriousbees.in (API under /api)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS="gmail.com,srmist.edu.in"   # UX hint only; the API enforces
NEXT_PUBLIC_AUTH_MODE="GOOGLE_ADMIN_MANAGED"

# ------------------------------------------------------------------------------
# B. WEB — server-only runtime (Next.js server / middleware)
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"                       # prod: https://srmcuriousbees.in (all redirects use this)
ALLOWED_EMAIL_DOMAINS="gmail.com,srmist.edu.in"

# ------------------------------------------------------------------------------
# C. API — plain runtime configuration
# ------------------------------------------------------------------------------
NODE_ENV="development"                                # prod: production (strict validation, fail-fast)
PORT=4000
FRONTEND_URL="http://localhost:3000"                  # prod: https://srmcuriousbees.in (CORS allow-list)
ALLOWED_ORIGINS=""                                    # extra comma-separated origins, normally empty
# Sign-in policy. Only these domains may sign in, and only if an admin created the account.
# Tighten later to "srmist.edu.in" with no code change.
ALLOWED_EMAIL_DOMAINS="gmail.com,srmist.edu.in"
SUPABASE_URL="https://your-project-ref.supabase.co"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="curiousbees-dev-files"
TRUST_PROXY_HOPS=0                                    # prod: 2 (CloudFront + ALB)
MAIL_FROM_EMAIL="no-reply@srmcuriousbees.in"         # Brevo-verified sender
MAIL_FROM_NAME="CuriousBees SRMIST"
MAIN_ADMIN_EMAIL=""                                   # optional ops inbox for alerts (not authorization)
ENABLE_CRON="false"                                   # safe on all tasks: jobs take a Postgres advisory lock
ENABLE_SWAGGER="false"                                # production only; always on in development
# First institute admin, created by the production seed only when no admin exists.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME=""

# ------------------------------------------------------------------------------
# D. API — SECRETS (production: SSM Parameter Store SecureString, never plain env)
# ------------------------------------------------------------------------------
# connection_limit caps Prisma's pool per task; sslmode=require for RDS.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/srm_curiousbees_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/srm_curiousbees_db?schema=public"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
BREVO_API_KEY="your-brevo-api-key"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
