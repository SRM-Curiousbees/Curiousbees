# ==============================================================================
# CURIOUSBEES V2 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your deployment-specific credentials.
# Do NOT commit real secrets to version control.
# ==============================================================================

# Application & Routing
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
ALLOWED_EMAIL_DOMAINS=srmist.edu.in
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=srmist.edu.in
AUTH_MODE=GOOGLE_ADMIN_MANAGED
NEXT_PUBLIC_AUTH_MODE=GOOGLE_ADMIN_MANAGED

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.ndtaxeqsefusocwgqppx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.ndtaxeqsefusocwgqppx.supabase.co:5432/postgres"

# Storage (AWS S3)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=curiousbees-dev-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Authentication (Supabase Auth)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Workspace & OAuth (Meet, Calendar, Chat Spaces)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional Email (Brevo)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CuriousBees

# Administration & Operations
MAIN_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Curiousbees
ENABLE_CRON=false
ENABLE_SWAGGER=true
