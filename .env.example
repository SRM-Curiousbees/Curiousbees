# ==============================================================================
# CURIOUSBEES V2 — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# All production secrets must come from AWS Secrets Manager or Parameter Store.
# Do NOT commit production credentials or values to source control.
# ==============================================================================

# --- 1. APPLICATION & RUNTIME ---
NODE_ENV=production
PORT=4000
DEVELOPMENT_MODE="false"

# --- 2. FRONTEND PUBLIC CONFIGURATION (Exposed to Next.js Browser Bundle) ---
# When deployed behind AWS ALB, NEXT_PUBLIC_API_URL can be set to the ALB origin or /api
NEXT_PUBLIC_API_URL="https://curiousbees.srmist.edu.in"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
ALLOWED_EMAIL_DOMAINS="gmail.com"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS="gmail.com"
NEXT_PUBLIC_AUTH_MODE="GOOGLE_ADMIN_MANAGED"

# --- 3. DATABASE CONFIGURATION (AWS RDS PostgreSQL) ---
# Dedicated connection pool for production. Use connection_limit query parameter (e.g. 20 per instance)
DATABASE_URL="postgresql://curiousbees_user:DB_PASSWORD_FROM_SECRETS_MGR@curiousbees-prod.xxxxxx.ap-south-1.rds.amazonaws.com:5432/srm_curiousbees_prod?schema=public&connection_limit=25&pool_timeout=15"
DIRECT_URL="postgresql://curiousbees_user:DB_PASSWORD_FROM_SECRETS_MGR@curiousbees-prod.xxxxxx.ap-south-1.rds.amazonaws.com:5432/srm_curiousbees_prod?schema=public"

# --- 4. SUPABASE AUTHENTICATION (Backend Secret) ---
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# --- 5. AWS S3 DOCUMENT STORAGE (Direct Browser Presigned Uploads) ---
# In production on EC2/ECS, AWS credentials should come from IAM Instance Profiles / Task Roles.
# Provide explicit access keys only for local development or CI environments.
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="curiousbees-production-documents-ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- 6. EMAIL ALERTS & TRANSACTIONAL NOTIFICATIONS (Brevo REST API) ---
BREVO_API_KEY="xkeysib-your-brevo-api-key-here"
MAIL_FROM_EMAIL="notifications@curiousbees.srmist.edu.in"
MAIL_FROM_NAME="CuriousBees SRMIST"

# --- 7. CORS & AWS ALB NETWORKING ---
FRONTEND_URL="https://curiousbees.srmist.edu.in"
ALLOWED_ORIGINS="https://curiousbees.srmist.edu.in,https://www.curiousbees.srmist.edu.in"

# --- 8. MULTI-INSTANCE & WORKER GOVERNANCE ---
# Set to 'true' only on a designated worker task or single EC2 instance to prevent duplicate cron runs
ENABLE_CRON="false"

# --- 9. INSTITUTIONAL ADMIN GOVERNANCE ---
MAIN_ADMIN_EMAIL="admin@srmist.edu.in"
ADMIN_EMAILS="admin@srmist.edu.in,curiousbees@srmist.edu.in"
